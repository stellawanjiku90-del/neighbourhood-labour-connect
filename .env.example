# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/neighbourhood_labour_connect?sslmode=require
# REQUIRED in production: long random secret, never commit it
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
PORT=3000
CORS_ORIGIN=https://your-production-domain.example
APP_NAME=Neighbourhood Labour Connect
# Comma-separated phone numbers that are allowed to be administrator accounts.
ADMIN_PHONES=+2547XXXXXXXX,+2547YYYYYYYY
ADMIN_INITIAL_PIN_HASH=
FIREBASE_WEB_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":""}
FIREBASE_SERVICE_ACCOUNT={}
VAPID_PUBLIC_KEY=
INTASEND_API_KEY=
INTASEND_PUBLISHABLE_KEY=
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520

# IntaSend M-Pesa phone verification
INTASEND_TEST_ENVIRONMENT=true
PHONE_VERIFICATION_AMOUNT_KES=100
VERIFICATION_RECEIPT_EMAIL=support@example.com
APP_URL=http://localhost:3000
