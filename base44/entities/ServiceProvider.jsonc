{
  "name": "ServiceProvider",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Provider full name"
    },
    "photo_url": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "professions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Service categories the provider offers"
    },
    "bio": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "firebase_uid": {
      "type": "string",
      "description": "Firebase UID of the provider \u2014 links to UserProfile, Subscription and DeviceToken for nearby-job notifications"
    },
    "location_name": {
      "type": "string",
      "description": "City / region label"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "service_radius_km": {
      "type": "number",
      "default": 10
    },
    "available": {
      "type": "boolean",
      "default": true
    },
    "availability_status": {
      "type": "string",
      "enum": [
        "online",
        "available",
        "busy",
        "offline"
      ],
      "default": "offline",
      "description": "Provider's current availability status shown to customers"
    },
    "years_experience": {
      "type": "number",
      "default": 0
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "reviews_count": {
      "type": "number",
      "default": 0
    },
    "completed_jobs": {
      "type": "number",
      "default": 0
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "earnings": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "professions"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.firebase_uid": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}