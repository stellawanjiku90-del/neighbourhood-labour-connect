{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "provider_id": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "provider_photo": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "last_message": {
      "type": "string"
    },
    "last_sender_id": {
      "type": "string"
    },
    "customer_revealed_number": {
      "type": "boolean",
      "default": false,
      "description": "Customer has consented to reveal their phone number"
    },
    "provider_revealed_number": {
      "type": "boolean",
      "default": false,
      "description": "Provider has consented to reveal their phone number"
    }
  },
  "required": [
    "provider_id",
    "customer_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.provider_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.provider_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}