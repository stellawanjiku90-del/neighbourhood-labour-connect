{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "provider_id": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "provider_photo": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "last_message": {
      "type": "string"
    },
    "last_sender_id": {
      "type": "string"
    },
    "customer_revealed_number": {
      "type": "boolean",
      "default": false,
      "description": "Customer has consented to reveal their phone number"
    },
    "provider_revealed_number": {
      "type": "boolean",
      "default": false,
      "description": "Provider has consented to reveal their phone number"
    }
  },
  "required": [
    "provider_id",
    "customer_id"
  ]
}