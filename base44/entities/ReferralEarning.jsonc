{
  "name": "ReferralEarning",
  "type": "object",
  "properties": {
    "earner_id": {
      "type": "string",
      "description": "Firebase UID of the user who earns the commission"
    },
    "earner_name": {
      "type": "string"
    },
    "source_subscriber_id": {
      "type": "string",
      "description": "Firebase UID of the subscriber whose payment generated this earning"
    },
    "source_name": {
      "type": "string"
    },
    "level": {
      "type": "number",
      "enum": [
        1,
        2,
        3
      ],
      "description": "1=direct (10%), 2=second (5%), 3=third (2%)"
    },
    "amount": {
      "type": "number",
      "description": "USD earned"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "paid"
      ],
      "default": "pending"
    }
  },
  "required": [
    "earner_id",
    "source_subscriber_id",
    "level",
    "amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.earner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}