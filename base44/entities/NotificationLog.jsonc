{
  "name": "NotificationLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Firebase UID of the notification recipient"
    },
    "user_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "job_alert",
        "message",
        "bid",
        "subscription",
        "referral",
        "payment",
        "withdrawal",
        "emergency"
      ],
      "description": "Notification category"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "delivered"
      ],
      "default": "sent"
    },
    "error": {
      "type": "string",
      "description": "Error message if delivery failed"
    },
    "device_count": {
      "type": "number",
      "default": 0,
      "description": "Number of devices the notification was sent to"
    }
  },
  "required": [
    "user_id",
    "type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}