{
  "name": "WithdrawalRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Firebase UID of the user requesting withdrawal"
    },
    "user_name": {
      "type": "string"
    },
    "user_phone": {
      "type": "string",
      "description": "Full phone number with + prefix"
    },
    "provider": {
      "type": "string",
      "description": "Mobile money provider: M-PESA, AIRTEL, or EQUITEL"
    },
    "amount": {
      "type": "number",
      "description": "USD amount requested"
    },
    "amount_kes": {
      "type": "number",
      "description": "KES amount as submitted to IntaSend"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "tracking_id": {
      "type": "string",
      "description": "IntaSend tracking ID after payout approval"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}