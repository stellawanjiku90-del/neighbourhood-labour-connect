{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "description": "Phone number with country code (unique identifier)"
    },
    "firebase_uid": {
      "type": "string",
      "description": "Firebase Authentication user UID"
    },
    "role": {
      "type": "string",
      "enum": [
        "customer",
        "provider",
        "admin"
      ],
      "default": "customer",
      "description": "Whether the user registered as a customer, service provider, or admin"
    },
    "pin_hash": {
      "type": "string",
      "description": "SHA-256 hash of the user's 4-digit login PIN"
    },
    "first_name": {
      "type": "string"
    },
    "surname": {
      "type": "string"
    },
    "age": {
      "type": "number"
    },
    "id_type": {
      "type": "string",
      "enum": [
        "National ID",
        "Passport",
        "Driver's License"
      ],
      "description": "Type of identification document"
    },
    "id_number": {
      "type": "string"
    },
    "id_photo_url": {
      "type": "string",
      "description": "URL of the uploaded ID document photo"
    },
    "id_names_extracted": {
      "type": "string",
      "description": "Names extracted from the ID by AI verification"
    },
    "id_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the ID names match the provided names"
    },
    "profile_photo_url": {
      "type": "string"
    },
    "location_name": {
      "type": "string",
      "description": "Auto-detected human-readable location (city, country)"
    },
    "lat": {
      "type": "number",
      "description": "Auto-detected latitude"
    },
    "lng": {
      "type": "number",
      "description": "Auto-detected longitude"
    },
    "profile_completed": {
      "type": "boolean",
      "default": false
    },
    "referral_code": {
      "type": "string",
      "description": "Unique shareable referral code for this user"
    },
    "referred_by": {
      "type": "string",
      "description": "Firebase UID of the user who referred them"
    },
    "notif_jobs": {
      "type": "boolean",
      "default": true,
      "description": "Receive new job alerts (providers)"
    },
    "notif_messages": {
      "type": "boolean",
      "default": true,
      "description": "Receive new message notifications"
    },
    "notif_bids": {
      "type": "boolean",
      "default": true,
      "description": "Receive bid status updates (customers)"
    },
    "notif_subscription": {
      "type": "boolean",
      "default": true,
      "description": "Receive subscription expiry reminders"
    },
    "notif_referrals": {
      "type": "boolean",
      "default": true,
      "description": "Receive referral earnings notifications"
    },
    "notif_payments": {
      "type": "boolean",
      "default": true,
      "description": "Receive payment and withdrawal notifications"
    },
    "notif_emergency": {
      "type": "boolean",
      "default": true,
      "description": "Receive emergency job notifications"
    }
  },
  "required": [
    "phone"
  ]
}