{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_id": {
      "type": "string",
      "description": "Firebase UID of the referrer"
    },
    "referrer_name": {
      "type": "string"
    },
    "referred_id": {
      "type": "string",
      "description": "Firebase UID of the referred user"
    },
    "referred_name": {
      "type": "string"
    },
    "referred_phone": {
      "type": "string"
    },
    "referral_code_used": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "subscribed"
      ],
      "default": "registered"
    }
  },
  "required": [
    "referrer_id",
    "referred_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.referrer_id": "{{user.id}}"
        },
        {
          "data.referred_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}