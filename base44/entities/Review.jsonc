{
  "name": "Review",
  "type": "object",
  "properties": {
    "provider_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "stars": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    }
  },
  "required": [
    "provider_id",
    "stars"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}