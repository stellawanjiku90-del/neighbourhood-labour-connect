      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "stars": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    }
  },
  "required": [
    "provider_id",
    "stars"
  ]
}