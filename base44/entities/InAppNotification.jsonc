{
  "name": "InAppNotification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Firebase UID of the notification recipient"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "job_match",
        "message",
        "bid",
        "system"
      ],
      "default": "system",
      "description": "Event category that triggered this notification"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string",
      "description": "Route to navigate to when the notification is clicked"
    }
  },
  "required": [
    "user_id",
    "title"
  ]
}