{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "emergency": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "open"
    },
    "assigned_provider_id": {
      "type": "string"
    },
    "assigned_provider_name": {
      "type": "string"
    },
    "budget": {
      "type": "number"
    },
    "rated": {
      "type": "boolean",
      "default": false
    },
    "customer_id": {
      "type": "string",
      "description": "Firebase UID of the customer who posted the request"
    },
    "customer_name": {
      "type": "string",
      "description": "Display name of the customer"
    },
    "provider_lat": {
      "type": "number",
      "description": "Live latitude of the assigned provider while en route"
    },
    "provider_lng": {
      "type": "number",
      "description": "Live longitude of the assigned provider while en route"
    },
    "provider_loc_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the provider last updated their live location"
    }
  },
  "required": [
    "category",
    "title"
  ]
}