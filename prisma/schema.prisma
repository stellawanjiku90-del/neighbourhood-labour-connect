generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model User { id String @id @default(cuid()); phone String? @unique; email String? @unique; passwordHash String?; firebaseUid String? @unique; role String @default("customer"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; profile UserProfile? }
model VerificationPayment { id String @id @default(cuid()); phone String; purpose String; invoiceId String? @unique; apiRef String @unique; amount Float @default(100); currency String @default("KES"); status String @default("PENDING"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; paidAt DateTime?; expiresAt DateTime; @@index([phone,purpose,status]) }
model UserProfile { id String @id @default(cuid()); userId String @unique; phone String?; firebaseUid String?; role String @default("customer"); pinHash String?; firstName String?; surname String?; age Int?; idType String?; idNumber String?; idPhotoUrl String?; idNamesExtracted String?; idVerified Boolean @default(false); profilePhotoUrl String?; locationName String?; lat Float?; lng Float?; profileCompleted Boolean @default(false); referralCode String? @unique; referredBy String?; notifJobs Boolean @default(true); notifMessages Boolean @default(true); notifBids Boolean @default(true); notifSubscription Boolean @default(true); notifReferrals Boolean @default(true); notifPayments Boolean @default(true); notifEmergency Boolean @default(true); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model ServiceProvider { id String @id @default(cuid()); name String; photoUrl String?; professions String[] @default([]); bio String?; phone String?; firebaseUid String?; userId String?; locationName String?; lat Float?; lng Float?; serviceRadiusKm Float @default(10); available Boolean @default(true); availabilityStatus String @default("offline"); yearsExperience Int @default(0); rating Float @default(0); reviewsCount Int @default(0); completedJobs Int @default(0); verified Boolean @default(false); featured Boolean @default(false); earnings Float @default(0); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model ServiceRequest { id String @id @default(cuid()); category String?; title String; description String?; locationName String?; lat Float?; lng Float?; emergency Boolean @default(false); status String @default("open"); assignedProviderId String?; assignedProviderName String?; budget Float?; rated Boolean @default(false); customerId String?; customerName String?; providerLat Float?; providerLng Float?; providerLocUpdatedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model JobBid { id String @id @default(cuid()); requestId String; requestTitle String?; providerId String; providerName String?; providerPhoto String?; charge Float; message String?; status String @default("pending"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Conversation { id String @id @default(cuid()); providerId String; providerName String?; providerPhoto String?; customerId String; customerName String?; lastMessage String?; lastSenderId String?; customerRevealedNumber Boolean @default(false); providerRevealedNumber Boolean @default(false); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Message { id String @id @default(cuid()); conversationId String; senderId String; senderName String?; text String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Review { id String @id @default(cuid()); providerId String; requestId String?; reviewerName String?; stars Int; comment String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Subscription { id String @id @default(cuid()); userId String; userPhone String?; userName String?; status String @default("active"); amount Float @default(1); periodStart DateTime; periodEnd DateTime; activatedBy String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model DeviceToken { id String @id @default(cuid()); userId String; token String; platform String @default("web"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([userId,token]) }
model InAppNotification { id String @id @default(cuid()); userId String; title String; body String?; type String @default("system"); read Boolean @default(false); link String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model NotificationLog { id String @id @default(cuid()); userId String; userName String?; type String; title String?; body String?; status String @default("sent"); error String?; deviceCount Int @default(0); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Referral { id String @id @default(cuid()); referrerId String; referrerName String?; referredId String; referredName String?; referredPhone String?; referralCodeUsed String?; status String @default("registered"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model ReferralEarning { id String @id @default(cuid()); earnerId String; earnerName String?; sourceSubscriberId String; sourceName String?; level Int; amount Float; status String @default("pending"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model UserPresence { id String @id @default(cuid()); userId String @unique; userName String?; role String?; lastActive DateTime @default(now()); isOnline Boolean @default(false); providerStatus String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model WithdrawalRequest { id String @id @default(cuid()); userId String; userName String?; userPhone String?; provider String?; amount Float; amountKes Float; status String @default("pending"); trackingId String?; errorMessage String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
